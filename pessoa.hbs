<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pessoa</title>
</head>

<body>

    <table>
        <tr>
            <th>ID</th>
            <th>NOME</th>
        </tr>
        {{#each data}}
        <tr>
            <td>{{this.ID}}</td>
            <td>{{this.NOME}}</td>
        </tr>
        {{/each}}
    </table>

    <style>
        table,
        th,
        td {
            border: 1px solid;
        }
    </style>

</body>

</html>